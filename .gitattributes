# Unity écrit ses fichiers en LF : on les garde tels quels, quel que soit core.autocrlf.
* text=auto eol=lf

# Fichiers YAML de Unity : fusion sans réordonner les lignes
*.unity    text eol=lf merge=unityyamlmerge
*.prefab   text eol=lf merge=unityyamlmerge
*.asset    text eol=lf merge=unityyamlmerge
*.mat      text eol=lf
*.meta     text eol=lf
*.anim     text eol=lf
*.controller text eol=lf

# Binaires
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.exr  binary
*.hdr  binary
*.fbx  binary
*.obj  binary
*.blend binary
*.wav  binary
*.mp3  binary
*.ogg  binary
*.ttf  binary
*.otf  binary
*.dll  binary
